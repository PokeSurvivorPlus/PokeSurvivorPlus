{
  "manifest_version": 3,
  "name": "PokeSurvivor Plus",
  "version": "1.4.0",
  "description": "PokeSurvivor Plus: redesigned HUD, damage meter, minimap, controller support, alerts, quality-of-life tools and more!",
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://survivortiers.pages.dev/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://pokesurvivor.com/*",
        "https://www.pokesurvivor.com/*"
      ],
      "js": [
        "inject.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://pokesurvivor.com/*",
        "https://www.pokesurvivor.com/*"
      ],
      "js": [
        "keepalive.js"
      ],
      "run_at": "document_start"
    }
  ]
}
